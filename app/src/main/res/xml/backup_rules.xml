<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices below API 31. See data_extraction_rules.xml for API 31+.
   https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <!-- The DataStore holding the saved summary value is app state, not something the user
         expects to reappear on a new device. Exclude it rather than backing it up by default. -->
    <exclude domain="file" path="datastore/summary_settings.preferences_pb" />
</full-backup-content>
