<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for API 31+.
   https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Persisted app data is excluded by default here. Anything you do include leaves the
             device, so add entries deliberately rather than relying on the default. -->
        <exclude domain="file" path="datastore/summary_settings.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/summary_settings.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
